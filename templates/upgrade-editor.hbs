<div class="upg-form">
  <div class="upg-form-body">

  <section class="upg-fieldset">
    <div class="form-group">
      <label>Name</label>
      <input type="text" name="name" value="{{upgrade.name}}" placeholder="Nightbloom Sapling" autofocus>
    </div>

    <div class="form-group stacked">
      <label>Cost</label>
      <div class="upg-cost-rows">
        {{#each costRows}}
        <div class="upg-cost-row">
          <label>
            {{#if isImage}}<img class="upg-currency-img" src="{{icon}}" alt="">
            {{else}}<i class="{{icon}}"></i>{{/if}}
            {{name}}
          </label>
          <input type="number" name="cost:{{id}}" value="{{amount}}" min="0" step="1">
        </div>
        {{/each}}
      </div>
    </div>

    <div class="form-group">
      <label>Art</label>
      <div class="upg-file">
        <input type="text" name="img" value="{{upgrade.img}}" placeholder="worlds/mycampaign/art/plant.webp">
        <button type="button" data-action="pickImage" title="Browse"><i class="fa-solid fa-file-image"></i></button>
      </div>
    </div>

    <div class="form-group">
      <label>Flavor line</label>
      <input type="text" name="flavor" value="{{upgrade.flavor}}" placeholder="Planted in memory of those who fell.">
    </div>

    <div class="form-group stacked">
      <label>Description (HTML allowed)</label>
      <textarea name="description" rows="4">{{upgrade.description}}</textarea>
    </div>

    {{#if hasCategories}}
    <div class="form-group">
      <label>Section</label>
      <select name="categoryId">
        <option value="">— none —</option>
        {{#each categories}}
        <option value="{{id}}" {{#if isSelected}}selected{{/if}}>{{name}}</option>
        {{/each}}
      </select>
    </div>
    {{/if}}

    <div class="form-group">
      <label class="checkbox">
        <input type="checkbox" name="hidden" {{#if upgrade.hidden}}checked{{/if}}> Hidden — shows as a “???” teaser
      </label>
    </div>
  </section>

  {{#if hasPrerequisiteCandidates}}
  <section class="upg-fieldset">
    <h3>Comes after{{#if requiresCount}} <span class="upg-picker-count">{{requiresCount}} ticked</span>{{/if}}</h3>
    <p class="upg-hint">
      Tick anything that must be owned before this can be bought. It stays visible but locked
      until then, and the two are shown as linked.
    </p>
    <div class="upg-picker upg-prereqs" data-picker="requires">
      {{#if showRequiresFilter}}
      <input type="search" class="upg-picker-filter" name="requiresFilter" value="{{requiresFilter}}"
             placeholder="Filter by name or section…" autocomplete="off">
      {{/if}}
      <div class="upg-picker-list">
        {{#each prerequisites}}
        <label class="checkbox" data-search="{{search}}">
          <input type="checkbox" name="requires" value="{{id}}" {{#if isSelected}}checked{{/if}}>
          {{name}}{{#if section}} <span class="upg-picker-section">{{section}}</span>{{/if}}
        </label>
        {{/each}}
        <p class="upg-picker-empty upg-hint filtered-out">Nothing matches that.</p>
      </div>
    </div>
  </section>
  {{/if}}

  {{#if hasExclusionCandidates}}
  <section class="upg-fieldset">
    <h3>Cannot be taken with{{#if excludesCount}} <span class="upg-picker-count">{{excludesCount}} ticked</span>{{/if}}</h3>
    <p class="upg-hint">
      Tick anything the party must choose between. Buying either one rules out the other —
      refunding it opens the choice again. Ticking here says the same thing as ticking this
      upgrade over there, so it only needs doing once.
    </p>
    <div class="upg-picker upg-prereqs" data-picker="excludes">
      {{#if showExcludesFilter}}
      <input type="search" class="upg-picker-filter" name="excludesFilter" value="{{excludesFilter}}"
             placeholder="Filter by name or section…" autocomplete="off">
      {{/if}}
      <div class="upg-picker-list">
        {{#each exclusions}}
        <label class="checkbox" data-search="{{search}}">
          <input type="checkbox" name="excludes" value="{{id}}" data-action="rerender" {{#if isSelected}}checked{{/if}}>
          {{name}}{{#if section}} <span class="upg-picker-section">{{section}}</span>{{/if}}
        </label>
        {{/each}}
        <p class="upg-picker-empty upg-hint filtered-out">Nothing matches that.</p>
      </div>
    </div>
    {{#if exclusiveNote}}<p class="upg-hint">{{exclusiveNote}}</p>{{/if}}
  </section>
  {{/if}}

  <section class="upg-fieldset">
    <h3>Who does this apply to?</h3>

    <div class="form-group">
      <label>Target</label>
      <select name="target" data-action="rerender">
        {{#each targetOptions}}
        <option value="{{value}}" {{#if isSelected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>

    <div class="form-group">
      <label class="checkbox">
        <input type="checkbox" name="repeatable" {{#if upgrade.repeatable}}checked{{/if}}>
        Can be bought more than once
      </label>
    </div>

    {{#if isBuyerTarget}}
    <p class="upg-hint">
      Resolved when it is bought: a player's assigned character, or — if a GM buys it — whoever
      the GM picks. Combine with “can be bought more than once” for something each character
      acquires separately, like a tangible item.
    </p>
    {{/if}}

    {{#if isActorTarget}}
    <div class="form-group">
      <label>Character</label>
      <select name="targetActorId">
        <option value="">— choose a character —</option>
        {{#each actorGroups}}
        <optgroup label="{{label}}">
          {{#each actors}}
          <option value="{{id}}" {{#if isSelected}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </optgroup>
        {{/each}}
      </select>
    </div>
    {{#unless hasTargetActor}}
    <p class="upg-warn"><i class="fa-solid fa-triangle-exclamation"></i> Pick a character, or the effect will have nowhere to land.</p>
    {{/unless}}
    {{else}}
    <p class="upg-hint">{{partyNote}}</p>
    {{/if}}
  </section>

  <section class="upg-fieldset">
    <h3>What does it do?</h3>

    <div class="upg-modes">
      {{#each effectModeOptions}}
      <label class="checkbox">
        <input type="radio" name="effectMode" value="{{value}}" data-action="rerender" {{#if isSelected}}checked{{/if}}> {{label}}
      </label>
      {{/each}}
    </div>

    {{#if isBuild}}
      {{#unless builderSupported}}
      <p class="upg-warn">
        <i class="fa-solid fa-triangle-exclamation"></i>
        The bonus builder ships presets for dnd5e and PF2e. In {{systemId}} you can still add custom
        targets below, or link an existing effect instead.
      </p>
      {{/unless}}

      <div class="upg-rows">
        {{#each rows}}
        <div class="upg-row" data-index="{{index}}">
          <select name="rowPreset" data-action="rerender">
            {{#each presetGroups}}
            <optgroup label="{{label}}">
              {{#each presets}}
              <option value="{{id}}" {{#if isSelected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </optgroup>
            {{/each}}
          </select>

          {{#if isCustom}}
          <input type="text" name="rowKey" value="{{key}}"
                 placeholder="{{#if isPf2e}}attack, damage{{else}}system.attributes.ac.bonus{{/if}}" class="upg-key">
          {{#unless isPf2e}}
          <select name="rowMode" class="upg-mode">
            {{#each modeChoices}}
            <option value="{{value}}" {{#if isSelected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
          {{/unless}}
          {{/if}}

          <input type="text" name="rowValue" value="{{value}}" placeholder="{{placeholder}}" class="upg-value">

          {{#if isPf2e}}
          <select name="rowBonusType" class="upg-bonus-type" title="PF2e counts only the highest bonus of each type">
            {{#each bonusTypes}}
            <option value="{{id}}" {{#if isSelected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
          {{/if}}

          {{#if isDamage}}
          <select name="rowDamageType" class="upg-damage-type">
            <option value="">untyped</option>
            {{#each damageTypes}}
            <option value="{{id}}" {{#if isSelected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
          {{/if}}
          <button type="button" data-action="removeRow" data-index="{{index}}" title="Remove"><i class="fa-solid fa-xmark"></i></button>
        </div>
        {{else}}
        <p class="upg-empty">No bonuses yet.</p>
        {{/each}}
      </div>

      <button type="button" class="upg-add-row" data-action="addRow"><i class="fa-solid fa-plus"></i> Add a bonus</button>

      {{#if isPf2e}}
      <div class="upg-hint upg-legend">
        <p>Enter a flat number like <code>1</code>, or dice like <code>1d6</code>. Extra dice have no
          bonus type, so that dropdown disappears when you type dice.</p>
        <p><strong>Why the type matters:</strong> PF2e adds only the <em>largest</em> bonus of each type.
          Two item bonuses to AC do not become +2 — the bigger one simply wins.</p>
        <dl>
          {{#each bonusTypeLegend}}
          <dt>{{label}}</dt><dd>{{hint}}</dd>
          {{/each}}
        </dl>
        <p>If you only want it to work and do not care about the maths, pick <strong>Untyped</strong>.</p>
      </div>
      {{else}}
      <p class="upg-hint">
        Values are dnd5e roll formulas, and they should carry a sign: <code>+2</code> for a flat bonus,
        <code>+1d8[cold]</code> for typed dice — that is how “every weapon swing deals an extra 1d8 cold”
        is written. The sign is added for you if you leave it off; it matters because two upgrades
        touching the same bonus are joined end to end, and <code>+2+3</code> works where <code>23</code> does not.
        Ability scores and darkvision are plain numbers, so those take <code>2</code> and <code>60</code>.
      </p>
      {{/if}}
    {{/if}}

    {{#if isLink}}
      <div class="upg-drop {{#if linkedName}}filled{{/if}}" data-drop="effect">
        {{#if linkedName}}
          {{#if linkedImg}}<img src="{{linkedImg}}" alt="">{{/if}}
          <div class="upg-drop-text">
            <strong>{{linkedName}}</strong>
            <span>{{linkedType}}</span>
          </div>
          <button type="button" data-action="clearLink" title="Clear"><i class="fa-solid fa-xmark"></i></button>
        {{else}}
          <i class="fa-solid fa-hand-pointer"></i>
          <div class="upg-drop-text">
            <strong>Drag an Effect or Item here</strong>
            <span>from a character sheet, the Items sidebar, or a compendium</span>
          </div>
        {{/if}}
      </div>
      <div class="form-group">
        <label>UUID</label>
        <input type="text" name="effectUuid" value="{{upgrade.effectUuid}}" placeholder="filled in by dragging, or paste one">
      </div>
      {{#if linkMissing}}
      <p class="upg-warn"><i class="fa-solid fa-triangle-exclamation"></i> That UUID does not resolve to a document in this world.</p>
      {{/if}}
    {{/if}}

    {{#if showsGrantNote}}
    <div class="form-group">
      <label class="checkbox">
        <input type="checkbox" name="showInEffectsBar" data-action="rerender" {{#if upgrade.showInEffectsBar}}checked{{/if}}>
        Show it in the effects bar
      </label>
    </div>
    <div class="form-group">
      <label class="checkbox">
        <input type="checkbox" name="hideEffect" {{#if upgrade.hideEffect}}checked{{/if}}>
        Keep what it does secret until it is owned
      </label>
    </div>
    <p class="upg-hint">{{grantNote}}</p>
    {{/if}}
  </section>

  </div>

  <section class="upg-fieldset">
    <h3>Ask the buyer to choose</h3>
    <div class="form-group">
      <label class="checkbox">
        <input type="checkbox" name="choiceEnabled" data-action="rerender" {{#if upgrade.choiceEnabled}}checked{{/if}}>
        Have them nominate something when they buy this
      </label>
    </div>
    {{#if choiceEnabled}}
    <div class="form-group">
      <label>Question</label>
      <input type="text" name="choiceLabel" value="{{upgrade.choiceLabel}}" placeholder="Which spell?">
    </div>
    <div class="form-group stacked">
      <label>Guidance</label>
      <input type="text" name="choiceHint" value="{{upgrade.choiceHint}}"
             placeholder="Drag a spell from your spellbook.">
    </div>
    <p class="upg-hint">
      A window opens before the cost is paid; cancelling it buys nothing. What they pick names the
      granted item — “Temporary Scroll (Fireball)” — and is linked inside its description. Their
      answer is remembered, so re-syncing rebuilds the same personalised grant.
    </p>
    {{/if}}
  </section>

  <footer class="upg-form-footer">
    <button type="submit"><i class="fa-solid fa-floppy-disk"></i> {{saveLabel}}</button>
    <button type="button" data-action="cancel"><i class="fa-solid fa-ban"></i> Cancel</button>
  </footer>
</div>
