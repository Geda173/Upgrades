<div class="upg-form">
  <div class="upg-form-body">

  <section class="upg-fieldset">
    <div class="form-group">
      <label>Name</label>
      <input type="text" name="name" value="{{upgrade.name}}" placeholder="Nightbloom Sapling" autofocus>
    </div>

    <div class="form-group">
      <label>Cost ({{vocab.currencyName}})</label>
      <input type="number" name="cost" value="{{upgrade.cost}}" min="0" step="1">
    </div>

    <div class="form-group">
      <label>Art</label>
      <div class="upg-file">
        <input type="text" name="img" value="{{upgrade.img}}" placeholder="worlds/mycampaign/art/plant.webp">
        <button type="button" data-action="pickImage" title="Browse"><i class="fa-solid fa-file-image"></i></button>
      </div>
    </div>

    <div class="form-group">
      <label>Flavor line</label>
      <input type="text" name="flavor" value="{{upgrade.flavor}}" placeholder="Planted in memory of those who fell.">
    </div>

    <div class="form-group stacked">
      <label>Description (HTML allowed)</label>
      <textarea name="description" rows="4">{{upgrade.description}}</textarea>
    </div>

    <div class="form-group">
      <label class="checkbox">
        <input type="checkbox" name="hidden" {{#if upgrade.hidden}}checked{{/if}}> Hidden — shows as a “???” teaser
      </label>
    </div>
  </section>

  <section class="upg-fieldset">
    <h3>Who does this apply to?</h3>

    <div class="form-group">
      <label>Target</label>
      <select name="target" data-action="rerender">
        {{#each targetOptions}}
        <option value="{{value}}" {{#if isSelected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>

    {{#if isActorTarget}}
    <div class="form-group">
      <label>Character</label>
      <select name="targetActorId">
        <option value="">— choose a character —</option>
        {{#each actorGroups}}
        <optgroup label="{{label}}">
          {{#each actors}}
          <option value="{{id}}" {{#if isSelected}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </optgroup>
        {{/each}}
      </select>
    </div>
    {{#unless hasTargetActor}}
    <p class="upg-warn"><i class="fa-solid fa-triangle-exclamation"></i> Pick a character, or the effect will have nowhere to land.</p>
    {{/unless}}
    {{else}}
    <p class="upg-hint">{{partyNote}}</p>
    {{/if}}
  </section>

  <section class="upg-fieldset">
    <h3>What does it do?</h3>

    <div class="upg-modes">
      {{#each effectModeOptions}}
      <label class="checkbox">
        <input type="radio" name="effectMode" value="{{value}}" data-action="rerender" {{#if isSelected}}checked{{/if}}> {{label}}
      </label>
      {{/each}}
    </div>

    {{#if isBuild}}
      {{#unless builderSupported}}
      <p class="upg-warn">
        <i class="fa-solid fa-triangle-exclamation"></i>
        The bonus builder only ships presets for dnd5e. In {{systemId}} you can still add custom data paths below,
        or link an existing effect instead.
      </p>
      {{/unless}}

      <div class="upg-rows">
        {{#each rows}}
        <div class="upg-row" data-index="{{index}}">
          <select name="rowPreset" data-action="rerender">
            {{#each presetGroups}}
            <optgroup label="{{label}}">
              {{#each presets}}
              <option value="{{id}}" {{#if isSelected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </optgroup>
            {{/each}}
          </select>

          {{#if isCustom}}
          <input type="text" name="rowKey" value="{{key}}" placeholder="system.attributes.ac.bonus" class="upg-key">
          <select name="rowMode" class="upg-mode">
            {{#each modeChoices}}
            <option value="{{value}}" {{#if isSelected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
          {{/if}}

          <input type="text" name="rowValue" value="{{value}}" placeholder="{{placeholder}}" class="upg-value">
          <button type="button" data-action="removeRow" data-index="{{index}}" title="Remove"><i class="fa-solid fa-xmark"></i></button>
        </div>
        {{else}}
        <p class="upg-empty">No bonuses yet.</p>
        {{/each}}
      </div>

      <button type="button" class="upg-add-row" data-action="addRow"><i class="fa-solid fa-plus"></i> Add a bonus</button>

      <p class="upg-hint">
        Values are dnd5e roll formulas, and they should carry a sign: <code>+2</code> for a flat bonus,
        <code>+1d8[cold]</code> for typed dice — that is how “every weapon swing deals an extra 1d8 cold”
        is written. The sign is added for you if you leave it off; it matters because two upgrades
        touching the same bonus are joined end to end, and <code>+2+3</code> works where <code>23</code> does not.
        Ability scores and darkvision are plain numbers, so those take <code>2</code> and <code>60</code>.
      </p>
    {{/if}}

    {{#if isLink}}
      <div class="upg-drop {{#if linkedName}}filled{{/if}}" data-drop="effect">
        {{#if linkedName}}
          {{#if linkedImg}}<img src="{{linkedImg}}" alt="">{{/if}}
          <div class="upg-drop-text">
            <strong>{{linkedName}}</strong>
            <span>{{linkedType}}</span>
          </div>
          <button type="button" data-action="clearLink" title="Clear"><i class="fa-solid fa-xmark"></i></button>
        {{else}}
          <i class="fa-solid fa-hand-pointer"></i>
          <div class="upg-drop-text">
            <strong>Drag an Effect or Item here</strong>
            <span>from a character sheet, the Items sidebar, or a compendium</span>
          </div>
        {{/if}}
      </div>
      <div class="form-group">
        <label>UUID</label>
        <input type="text" name="effectUuid" value="{{upgrade.effectUuid}}" placeholder="filled in by dragging, or paste one">
      </div>
      {{#if linkMissing}}
      <p class="upg-warn"><i class="fa-solid fa-triangle-exclamation"></i> That UUID does not resolve to a document in this world.</p>
      {{/if}}
    {{/if}}

    {{#if showsGrantNote}}
    <p class="upg-hint">{{grantNote}}</p>
    {{/if}}
  </section>

  </div>

  <footer class="upg-form-footer">
    <button type="submit"><i class="fa-solid fa-floppy-disk"></i> {{saveLabel}}</button>
    <button type="button" data-action="cancel"><i class="fa-solid fa-ban"></i> Cancel</button>
  </footer>
</div>
