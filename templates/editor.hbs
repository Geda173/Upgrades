<div class="upg-editor-body">
  <section class="upg-ledger">
    <div class="upg-balance inline">
      {{#if vocab.currencyIconIsImg}}<img class="upg-currency-img" src="{{vocab.currencyIcon}}" alt="">
      {{else}}<i class="{{vocab.currencyIcon}}"></i>{{/if}}
      <strong>{{balance}}</strong> {{vocab.currencyName}}
    </div>
    <button type="button" data-action="adjustBalance"><i class="fa-solid fa-plus-minus"></i> Adjust {{vocab.currencyName}}</button>
    <button type="button" data-action="resync" title="Re-create any missing granted effects on their current targets (late joiners, roster changes, hand-deleted effects)"><i class="fa-solid fa-rotate"></i> Re-sync effects</button>
    <button type="button" data-action="openSettings"><i class="fa-solid fa-sliders"></i> Setup</button>
  </section>

  <section class="upg-categories">
    <header>
      <h3>Sections</h3>
      <button type="button" data-action="addCategory"><i class="fa-solid fa-plus"></i> New section</button>
    </header>
    {{#if hasCategories}}
    <ul class="upg-category-list">
      {{#each categories}}
      <li>
        <i class="{{icon}}"></i>
        <span class="upg-category-name">{{name}}</span>
        <a data-action="moveCategoryUp" data-id="{{id}}" title="Move up"><i class="fa-solid fa-chevron-up"></i></a>
        <a data-action="moveCategoryDown" data-id="{{id}}" title="Move down"><i class="fa-solid fa-chevron-down"></i></a>
        <a data-action="editCategory" data-id="{{id}}" title="Rename"><i class="fa-solid fa-pen"></i></a>
        <a data-action="removeCategory" data-id="{{id}}" title="Delete"><i class="fa-solid fa-trash"></i></a>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="upg-hint">No sections yet. Upgrades show as one flat list until you add some.</p>
    {{/if}}
  </section>

  <section class="upg-list">
    <header>
      <h3>Upgrades</h3>
      <button type="button" data-action="addUpgrade"><i class="fa-solid fa-plus"></i> New upgrade</button>
    </header>
    <table>
      <thead><tr><th></th><th>Name</th><th>Applies to</th><th>Cost</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>
        {{#each groups}}
        {{#if name}}
        <tr class="upg-group-row"><td colspan="6"><i class="{{icon}}"></i> {{name}}</td></tr>
        {{/if}}
        {{#each upgrades}}
        <tr class="{{#if purchased}}owned{{/if}} {{#if hidden}}hidden-row{{/if}}">
          <td class="upg-thumb">{{#if img}}<img src="{{img}}" alt="">{{else}}<i class="fa-solid fa-wand-sparkles"></i>{{/if}}</td>
          <td>
            {{name}}
            {{#if effectLabel}}<div class="upg-effect-label"><i class="fa-solid fa-bolt"></i> {{effectLabel}}</div>{{/if}}
          </td>
          <td class="upg-target">{{targetLabel}}</td>
          <td>{{cost}}</td>
          <td>
            {{#if purchased}}<span class="tag owned">Owned ({{purchasedBy}})</span>
            {{else if hidden}}<span class="tag hidden">Hidden</span>
            {{else}}<span class="tag">Available</span>{{/if}}
          </td>
          <td class="upg-actions">
            <a data-action="editUpgrade" data-id="{{id}}" title="Edit"><i class="fa-solid fa-pen"></i></a>
            <a data-action="toggleHidden" data-id="{{id}}" title="Toggle hidden"><i class="fa-solid {{#if hidden}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></a>
            {{#if purchased}}<a data-action="refund" data-id="{{id}}" title="Refund"><i class="fa-solid fa-rotate-left"></i></a>{{/if}}
            <a data-action="deleteUpgrade" data-id="{{id}}" title="Delete"><i class="fa-solid fa-trash"></i></a>
          </td>
        </tr>
        {{/each}}
        {{else}}
        <tr><td colspan="6" class="upg-empty">No upgrades yet — create your first one.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </section>

  <section class="upg-history">
    <h3>Recent history</h3>
    <ul>
      {{#each history}}
      <li>
        <span class="when">{{when}}</span> —
        {{#if isPurchase}}<strong>{{name}}</strong> acquired for {{cost}} (by {{by}})
        {{else}}{{../vocab.currencyName}} {{deltaStr}} ({{before}} → {{after}}){{#if reason}} — {{reason}}{{/if}}{{/if}}
      </li>
      {{else}}
      <li class="upg-empty">Nothing yet.</li>
      {{/each}}
    </ul>
  </section>
</div>
