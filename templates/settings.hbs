<div class="upg-settings">

  <div class="upg-settings-panes">

    <section class="upg-settings-form">

      <h3>Appearance</h3>

      <div class="form-group">
        <label>Theme</label>
        <div class="upg-theme-picker">
          {{#each themeGroups}}
          <div class="upg-theme-group">
            <span class="upg-theme-group-label">{{label}}</span>
            <div class="upg-theme-swatches">
              {{#each themes}}
              <button type="button" class="upg-swatch upgrades upg-theme-{{id}} {{#if isSelected}}active{{/if}}"
                      data-action="pickTheme" data-theme="{{id}}" title="{{label}} — {{blurb}}">
                <span class="upg-swatch-bands">
                  <span class="b1"></span><span class="b2"></span><span class="b3"></span>
                </span>
                <span class="upg-swatch-name">{{label}}</span>
              </button>
              {{/each}}
            </div>
          </div>
          {{/each}}
        </div>
      </div>

      <div class="form-group">
        <label>Window title</label>
        <input type="text" name="windowTitle" value="{{draft.windowTitle}}" placeholder="The Memorial Garden">
      </div>

      <div class="form-group">
        <label>Host name</label>
        <input type="text" name="hostName" value="{{draft.hostName}}" placeholder="Elara’s Respite">
      </div>

      <div class="form-group">
        <label>Greeting</label>
        <input type="text" name="greeting" value="{{draft.greeting}}" placeholder="The soil remembers.">
      </div>

      <div class="form-group stacked">
        <label>Merchant actor (optional)</label>
        <div class="upg-drop {{#if hostActorName}}filled{{/if}}" data-drop="host-actor">
          {{#if hostActorName}}
            <i class="fa-solid fa-user-tie"></i>
            <div class="upg-drop-text">
              <strong>{{hostActorName}}</strong>
              <span>double-clicking their token opens this window</span>
            </div>
            <button type="button" data-action="clearHostActor" title="Clear"><i class="fa-solid fa-xmark"></i></button>
          {{else}}
            <i class="fa-solid fa-hand-pointer"></i>
            <div class="upg-drop-text">
              <strong>Drag an Actor here</strong>
              <span>gives the party somewhere to go to trade</span>
            </div>
          {{/if}}
        </div>
        <input type="hidden" name="hostActor" value="{{draft.hostActor}}">
        {{#if merchantNeedsAccess}}
        <p class="upg-warn">
          <i class="fa-solid fa-triangle-exclamation"></i>
          Players have no access to this actor, so Foundry will not deliver their double-clicks to
          the token — it simply will not respond, and only for them.
        </p>
        <button type="button" class="upg-add-row" data-action="grantMerchantAccess">
          <i class="fa-solid fa-key"></i> Give players access
        </button>
        {{/if}}
        <p class="upg-hint">
          Their name and portrait are used below unless you override them. Pair this with turning
          off “players can open the window themselves” and the only way in is to visit them.
        </p>
      </div>

      <div class="form-group stacked">
        <label>Host portrait</label>
        <div class="upg-icon-picker">
          {{#each hostIconGroups}}
          <div class="upg-icon-group">
            <span class="upg-icon-group-label">{{label}}</span>
            <div class="upg-icon-row">
              {{#each icons}}
              <button type="button" class="upg-icon-choice {{#if isSelected}}active{{/if}}"
                      data-action="pickHostIcon" data-icon="{{cls}}" title="{{name}}">
                <i class="{{cls}}"></i>
              </button>
              {{/each}}
            </div>
          </div>
          {{/each}}
        </div>
        <div class="upg-file upg-icon-custom">
          <input type="text" name="hostImg" value="{{draft.hostImg}}" placeholder="an icon above, or browse for artwork">
          <button type="button" data-action="pickHostImg" title="Browse for an image"><i class="fa-solid fa-folder-open"></i></button>
          {{#if draft.hostImg}}
          <button type="button" data-action="clearHostImg" title="Clear"><i class="fa-solid fa-xmark"></i></button>
          {{/if}}
        </div>
        <p class="upg-hint">Pick an icon, or browse for your own portrait art.</p>
      </div>

      <h3>Resources</h3>

      <ul class="upg-currency-list">
        {{#each currencies}}
        <li>
          {{#if isImage}}<img class="upg-currency-img" src="{{icon}}" alt="">{{else}}<i class="{{icon}}"></i>{{/if}}
          <span class="upg-currency-name">{{name}}</span>
          <a data-action="editCurrency" data-id="{{id}}" title="Edit"><i class="fa-solid fa-pen"></i></a>
          <a data-action="removeCurrency" data-id="{{id}}" title="Remove"><i class="fa-solid fa-trash"></i></a>
        </li>
        {{/each}}
      </ul>
      <button type="button" class="upg-add-row" data-action="addCurrency"><i class="fa-solid fa-plus"></i> Add a resource</button>
      <p class="upg-hint">
        One is plenty for most tables. Add more and every upgrade can be priced in any combination
        of them — an upgrade might cost 3 Sprigs and 1 Pearl of Power.
      </p>

      <div class="form-group">
        <label>Primary name</label>
        <input type="text" name="currencyName" value="{{draft.currencyName}}" placeholder="Sprigs">
      </div>

      <div class="form-group">
        <label>Action button</label>
        <input type="text" name="actionVerb" value="{{draft.actionVerb}}" placeholder="Plant">
      </div>

      <div class="form-group stacked">
        <label>Icon</label>
        <div class="upg-icon-picker">
          {{#each iconGroups}}
          <div class="upg-icon-group">
            <span class="upg-icon-group-label">{{label}}</span>
            <div class="upg-icon-row">
              {{#each icons}}
              <button type="button" class="upg-icon-choice {{#if isSelected}}active{{/if}}"
                      data-action="pickIcon" data-icon="{{cls}}" title="{{name}}">
                <i class="{{cls}}"></i>
              </button>
              {{/each}}
            </div>
          </div>
          {{/each}}
        </div>
        <div class="upg-file upg-icon-custom">
          <input type="text" name="currencyIcon" value="{{draft.currencyIcon}}" placeholder="fa-solid fa-seedling">
          <button type="button" data-action="pickIconImage" title="Use your own image instead"><i class="fa-solid fa-folder-open"></i></button>
        </div>
        <p class="upg-hint">Pick one above, or browse for your own image.</p>
      </div>

      <div class="form-group stacked">
        <label>Physical currency (optional)</label>
        <div class="upg-drop {{#if currencyItemName}}filled{{/if}}" data-drop="currency-item">
          {{#if currencyItemName}}
            <i class="fa-solid fa-coins"></i>
            <div class="upg-drop-text">
              <strong>{{currencyItemName}}</strong>
              <span>one of these is worth one {{draft.currencyName}}</span>
            </div>
            <button type="button" data-action="clearCurrencyItem" title="Clear"><i class="fa-solid fa-xmark"></i></button>
          {{else}}
            <i class="fa-solid fa-hand-pointer"></i>
            <div class="upg-drop-text">
              <strong>Drag an Item here</strong>
              <span>lets you hide payment in a chest for the party to loot</span>
            </div>
          {{/if}}
        </div>
        <input type="hidden" name="currencyItem" value="{{draft.currencyItem}}">
        <label class="checkbox">
          <input type="checkbox" name="autoDeposit" {{#if draft.autoDeposit}}checked{{/if}}>
          Credit it the moment a player picks it up
        </label>
        <p class="upg-hint">
          Leave that unticked and players hand it in with a button in this window instead — an item
          vanishing out of the inventory you just looted it into is startling if you did not ask for it.
        </p>
      </div>

      <h3>Behaviour</h3>

      <div class="form-group">
        <label>Party actor</label>
        <select name="partyActor">
          {{#each partyActorChoices}}
          <option value="{{id}}" {{#if isSelected}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </select>
      </div>
      {{#unless hasPartyActor}}
      <p class="upg-warn">
        <i class="fa-solid fa-triangle-exclamation"></i>
        {{partyWarning}}
      </p>
      {{/unless}}

      <div class="form-group">
        <label class="checkbox">
          <input type="checkbox" name="requireApproval" {{#if draft.requireApproval}}checked{{/if}}>
          Purchases need my approval
        </label>
      </div>

      <div class="form-group">
        <label class="checkbox">
          <input type="checkbox" name="playersCanOpen" {{#if draft.playersCanOpen}}checked{{/if}}>
          Players can open the window themselves
        </label>
      </div>
    </section>

    <aside class="upg-settings-preview">
      <span class="upg-preview-label">Live preview</span>

      <div class="upgrades upg-theme-{{draft.theme}} upg-preview" data-preview>
        <div class="upg-preview-bar"><span data-bind="windowTitle">{{draft.windowTitle}}</span></div>
        <div class="upg-window">
          <header class="upg-banner">
            <div class="upg-npc" data-bind="host-portrait">
              {{#if hostIsImage}}<img src="{{draft.hostImg}}" alt="">{{else}}<i class="{{hostIconClass}}"></i>{{/if}}
            </div>
            <div class="upg-title">
              <h1 data-bind="hostName">{{draft.hostName}}</h1>
              <div class="upg-sub" data-bind="greeting">“{{draft.greeting}}”</div>
            </div>
            <div class="upg-balance">
              <div class="upg-num">
                <span data-bind="currency-icon">
                  {{#if currencyIconIsImg}}<img class="upg-currency-img" src="{{draft.currencyIcon}}" alt="">
                  {{else}}<i class="{{iconClassOrDefault}}"></i>{{/if}}
                </span>
                7
              </div>
              <div class="upg-lbl" data-bind="currencyName">{{draft.currencyName}}</div>
            </div>
          </header>

          <section class="upg-grid">
            <div class="upg-card active">
              <div class="upg-art"><i class="fa-solid fa-wand-sparkles"></i></div>
              <div class="upg-body">
                <h3>Nightbloom Sapling</h3>
                <div class="upg-for"><i class="fa-solid fa-user"></i> Galadon</div>
                <div class="upg-flavor"><em>Opens only for those who kept watch.</em></div>
                <div class="upg-cost">
                  <span data-bind="currency-icon">
                    {{#if currencyIconIsImg}}<img class="upg-currency-img" src="{{draft.currencyIcon}}" alt="">
                    {{else}}<i class="{{iconClassOrDefault}}"></i>{{/if}}
                  </span>
                  3
                  <button type="button" class="upg-buy" data-bind="actionVerb" tabindex="-1">{{draft.actionVerb}}</button>
                </div>
              </div>
            </div>

            <div class="upg-card owned">
              <div class="upg-stamp">Owned</div>
              <div class="upg-art"><i class="fa-solid fa-wand-sparkles"></i></div>
              <div class="upg-body">
                <h3>Ashen Fern</h3>
                <div class="upg-flavor"><em>Grown from the ruin of the eastern hold.</em></div>
                <div class="upg-cost">
                  <span data-bind="currency-icon">
                    {{#if currencyIconIsImg}}<img class="upg-currency-img" src="{{draft.currencyIcon}}" alt="">
                    {{else}}<i class="{{iconClassOrDefault}}"></i>{{/if}}
                  </span>
                  2
                </div>
              </div>
            </div>
          </section>
        </div>
      </div>

      <p class="upg-hint">Sample content — your own upgrades and art replace it.</p>
    </aside>
  </div>

  <footer class="upg-form-footer">
    <button type="submit"><i class="fa-solid fa-floppy-disk"></i> Save</button>
    <button type="button" data-action="cancel"><i class="fa-solid fa-ban"></i> Cancel</button>
  </footer>
</div>
